+// ---------------------------------------------------------------------------
+// Background exit summaries (local patch)
+// ---------------------------------------------------------------------------
+// Quitting used to block on the summary LLM call (several seconds). Instead,
+// the prompt is handed to a detached node process that makes the call, appends
+// the entry to the daily log, and runs `qmd update`, so pi exits right away.
+// Disable with PI_MEMORY_EXIT_SUMMARY_BACKGROUND=0. Worker errors are logged
+// to $TMPDIR/pi-memory-exit-summary.log.
+
+const EXIT_SUMMARY_WORKER_TIMEOUT_MS = 120_000;
+
+const EXIT_SUMMARY_WORKER = String.raw`
+import fs from "node:fs";
+import { execFile } from "node:child_process";
+const jobPath = process.env.PI_MEMORY_JOB;
+const job = JSON.parse(fs.readFileSync(jobPath, "utf8"));
+fs.rmSync(jobPath, { force: true });
+const log = (m) => { try { fs.appendFileSync(job.logPath, new Date().toISOString() + " [" + job.sid + "] " + m + "\n"); } catch {} };
+setTimeout(() => { log("timed out"); process.exit(1); }, job.timeoutMs).unref();
+const isEmpty = (s) => {
+  const lines = s.split("\n").map((l) => l.trim()).filter((l) => l && !l.startsWith("#"));
+  return lines.length === 0 || lines.every((l) => /^none\.?$/i.test(l.replace(/^[-*+]\s*/, "")));
+};
+try {
+  const { complete } = await import(job.compatUrl);
+  const res = await complete(
+    job.model,
+    { systemPrompt: job.systemPrompt, messages: [{ role: "user", content: [{ type: "text", text: job.userPrompt }], timestamp: Date.now() }] },
+    { apiKey: process.env.PI_MEMORY_JOB_API_KEY, reasoningEffort: "low" },
+  );
+  const text = (res.content || []).filter((c) => c.type === "text").map((c) => c.text).join("\n").trim();
+  if (!text) { log("empty summary" + (res.errorMessage ? ": " + res.errorMessage : "")); process.exit(0); }
+  if (isEmpty(text)) process.exit(0);
+  const existing = fs.existsSync(job.filePath) ? fs.readFileSync(job.filePath, "utf8") : "";
+  fs.appendFileSync(job.filePath, (existing.trim() ? "\n\n" : "") + job.prefix + text, "utf8");
+  if (job.qmdUpdate) execFile("qmd", ["update"], { timeout: 30000 }, () => process.exit(0));
+  else process.exit(0);
+} catch (err) {
+  log("error: " + (err && err.stack ? err.stack : String(err)));
+  process.exit(1);
+}
+`;
+
+export function isExitSummaryBackgroundEnabled(): boolean {
+	const value = (process.env.PI_MEMORY_EXIT_SUMMARY_BACKGROUND ?? "").trim().toLowerCase();
+	return !(value === "0" || value === "off" || value === "false" || value === "no");
+}
+
+/** Locate pi's own copy of pi-ai (the one jiti aliases for extensions) from the pi CLI path. */
+function findPiAiCompatUrl(): string | null {
+	const entry = process.argv[1];
+	if (!entry) return null;
+	let dir: string;
+	try {
+		dir = path.dirname(fs.realpathSync(entry));
+	} catch {
+		return null;
+	}
+	for (;;) {
+		const candidate = path.join(dir, "node_modules", "@earendil-works", "pi-ai", "dist", "compat.js");
+		if (fs.existsSync(candidate)) return pathToFileURL(candidate).href;
+		const parent = path.dirname(dir);
+		if (parent === dir) return null;
+		dir = parent;
+	}
+}
+
+/**
+ * Hand the exit summary to a detached worker. Returns true when the worker was
+ * spawned (or there was nothing to summarize), false to fall back to the
+ * in-process path.
+ */
+async function spawnBackgroundExitSummary(ctx: ExtensionContext, reason: ExitSummaryReason): Promise<boolean> {
+	if (process.versions.bun) return false;
+	const compatUrl = findPiAiCompatUrl();
+	if (!compatUrl) return false;
+
+	const prep = await prepareExitSummary(ctx);
+	if (!prep.ok) return true; // nothing worth summarizing; same outcome as the in-process path
+
+	const sid = shortSessionId(ctx.sessionManager.getSessionId());
+	const job = {
+		compatUrl,
+		model: prep.model,
+		systemPrompt: EXIT_SUMMARY_SYSTEM_PROMPT,
+		userPrompt: prep.userPrompt,
+		prefix: formatExitSummaryEntry("", reason, sid, nowTimestamp()),
+		filePath: dailyPath(todayStr()),
+		qmdUpdate: getQmdUpdateMode() === "background",
+		sid,
+		timeoutMs: Math.max(getExitSummaryTimeoutMs(), EXIT_SUMMARY_WORKER_TIMEOUT_MS),
+		logPath: path.join(os.tmpdir(), "pi-memory-exit-summary.log"),
+	};
+	const jobPath = path.join(os.tmpdir(), `pi-memory-exit-${sid}-${randomUUID()}.json`);
+	try {
+		fs.writeFileSync(jobPath, JSON.stringify(job), { encoding: "utf-8", mode: 0o600 });
+		const child = spawn(process.execPath, ["--input-type=module", "-e", EXIT_SUMMARY_WORKER], {
+			detached: true,
+			stdio: "ignore",
+			env: { ...process.env, PI_MEMORY_JOB: jobPath, PI_MEMORY_JOB_API_KEY: prep.apiKey },
+		});
+		child.unref();
+		return true;
+	} catch {
+		fs.rmSync(jobPath, { force: true });
+		return false;
+	}
+}
