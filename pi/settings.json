{
  "defaultProvider": "claude-code",
  "defaultModel": "default",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "claude-code/*",
    "openrouter/anthropic/*",
    "openrouter/meta/muse-spark-*",
    "openrouter/moonshotai/*",
    "openrouter/openai/*",
    "openrouter/z-ai/*"
  ],
  "packages": [
    "npm:pi-open-tui",
    "npm:pi-memory@0.4.2",
    "https://github.com/earendil-works/pi-claude-code"
  ],
  "quietStartup": true,
  "showCacheMissNotices": true,
  "defaultTools": [
    "+codemode"
  ]
}
